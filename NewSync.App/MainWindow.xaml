<Window x:Class="NewSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NewSync Ticker"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black"
        AllowsTransparency="False">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Close Program" Click="CloseProgram_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Padding="10" Background="Black">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: calendar name -->
            <TextBlock x:Name="CalendarNameText"
                       Grid.Row="0"
                       Foreground="#888888"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Stretch"
                       TextTrimming="CharacterEllipsis"
                       Text="NewSync" />

            <!-- Row 1: smooth-scrolling viewport — Height set in code-behind -->
            <ScrollViewer x:Name="ScrollViewport"
                          Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel x:Name="ScrollContent"
                            HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
